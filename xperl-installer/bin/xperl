#!/usr/bin/env perl

use strict;
use warnings;
use feature qw(dispatch_on signatures);
use FindBin;
use lib "$FindBin::Bin/../lib";
use File::Spec;
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use XPerl::Installer::Build;
use XPerl::Installer::Deps;
use XPerl::Installer::Fetch;
use XPerl::Installer::Registry;

sub usage () {
    return <<'USAGE';
Usage: xperl resolve [--mirror URL|DIR] [--cache DIR] Module::Name
       xperl fetch   [--mirror URL|DIR] [--cache DIR] Module::Name
       xperl install --prefix DIR [--registry DIR] [--repair-command PATH]
                     [--repair-attempts N] [--mirror URL|DIR] [--cache DIR] Module::Name

This source-tree command must run with XPerl. Installation supports
Makefile.PL and Build.PL releases and their declared required prerequisites.
USAGE
}

my $action = shift @ARGV // 'help';
my ($mirror, $cache, $refresh, $prefix, $registry, $repair_command,
    $repair_attempts);
GetOptionsFromArray(
    \@ARGV,
    'mirror=s' => \$mirror,
    'cache=s'  => \$cache,
    'refresh'  => \$refresh,
    'prefix=s' => \$prefix,
    'registry=s' => \$registry,
    'repair-command=s' => \$repair_command,
    'repair-attempts=i' => \$repair_attempts,
) or die usage();

my $module = shift @ARGV;
die usage() if @ARGV;

dispatch ($action) {
    on ('resolve') {
        die usage() unless defined $module;
        my $fetcher = XPerl::Installer::Fetch->new(
            (defined $mirror ? (mirror => $mirror) : ()),
            (defined $cache  ? (cache  => $cache)  : ()),
        );
        print JSON::PP->new->canonical->pretty->encode(
            $fetcher->resolve($module, refresh => $refresh));
    }
    on ('fetch') {
        die usage() unless defined $module;
        my $fetcher = XPerl::Installer::Fetch->new(
            (defined $mirror ? (mirror => $mirror) : ()),
            (defined $cache  ? (cache  => $cache)  : ()),
        );
        print JSON::PP->new->canonical->pretty->encode(
            $fetcher->fetch($module, refresh => $refresh));
    }
    on ('install') {
        die usage() unless defined $module && defined $prefix;
        my $fetcher = XPerl::Installer::Fetch->new(
            (defined $mirror ? (mirror => $mirror) : ()),
            (defined $cache  ? (cache  => $cache)  : ()),
        );
        my $builder = XPerl::Installer::Build->new(
            prefix => $prefix,
            workdir => File::Spec->catdir($cache // File::Spec->catdir(
                $ENV{HOME} // File::Spec->tmpdir, '.xperl', 'cache'), 'work'),
            (defined $registry ? (registry => XPerl::Installer::Registry->new(
                path => $registry)) : ()),
            (defined $repair_command ? (repair_command => $repair_command) : ()),
            (defined $repair_attempts ? (repair_attempts => $repair_attempts) : ()),
        );
        my $deps = XPerl::Installer::Deps->new(
            fetcher => $fetcher, builder => $builder);
        print JSON::PP->new->canonical->pretty->encode(
            $deps->install($module));
    }
    on (_) {
        die usage() if $action ne 'help' || defined $module;
        print usage();
    }
}
