#!/usr/bin/env perl

use strict;
use warnings;
use feature qw(dispatch_on signatures);
use FindBin;
use lib "$FindBin::Bin/../lib";
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use XPerl::Installer::Fetch;

sub usage () {
    return <<'USAGE';
Usage: xperl resolve [--mirror URL|DIR] [--cache DIR] Module::Name
       xperl fetch   [--mirror URL|DIR] [--cache DIR] Module::Name

This source-tree command must run with XPerl. It resolves CPAN module names
and fetches original release archives; it does not build or install yet.
USAGE
}

my $action = shift @ARGV // 'help';
my ($mirror, $cache, $refresh);
GetOptionsFromArray(
    \@ARGV,
    'mirror=s' => \$mirror,
    'cache=s'  => \$cache,
    'refresh'  => \$refresh,
) or die usage();

my $module = shift @ARGV;
die usage() if @ARGV;

dispatch ($action) {
    on ('resolve') {
        die usage() unless defined $module;
        my $fetcher = XPerl::Installer::Fetch->new(
            (defined $mirror ? (mirror => $mirror) : ()),
            (defined $cache  ? (cache  => $cache)  : ()),
        );
        print JSON::PP->new->canonical->pretty->encode(
            $fetcher->resolve($module, refresh => $refresh));
    }
    on ('fetch') {
        die usage() unless defined $module;
        my $fetcher = XPerl::Installer::Fetch->new(
            (defined $mirror ? (mirror => $mirror) : ()),
            (defined $cache  ? (cache  => $cache)  : ()),
        );
        print JSON::PP->new->canonical->pretty->encode(
            $fetcher->fetch($module, refresh => $refresh));
    }
    on (_) {
        die usage() if $action ne 'help' || defined $module;
        print usage();
    }
}
